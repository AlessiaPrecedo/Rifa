rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    

    match /numbers/{numberId} {
      allow read: if true;
      
      allow write: if request.auth != null && request.auth.uid == 'vd219SPAfkXFk0GlN8pcrWNoR5J2'
                   || (resource.data.estado == 'disponible' && request.resource.data.estado == 'reservado');
    }

   
    match /users/{userId} {
      allow create: if true; // Permite que Alessia guarde su ficha
      allow read, write: if request.auth != null && request.auth.uid == 'vd219SPAfkXFk0GlN8pcrWNoR5J2';
    }
  }
}